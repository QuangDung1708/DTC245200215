# Copy to .env and CHANGE ALL PASSWORDS before first run.
# Passwords below are placeholders, never use them outside local exercises.
MYSQL_DATABASE=uniforum
MYSQL_USER=forum_app
MYSQL_PASSWORD=REPLACE_WITH_32_RANDOM_HEX_CHARACTERS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_32_RANDOM_HEX
MYSQL_EXPORTER_PASSWORD=REPLACE_WITH_ANOTHER_32_RANDOM_HEX
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SESSION_SECRET
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD

# Docker Snap path (VMware Ubuntu classroom environment). Change for other installations.
DOCKER_ROOT_DIR=/var/snap/docker/common/var-lib-docker
